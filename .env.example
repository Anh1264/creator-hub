# Copy to .env.local and fill in.
# Leave the Supabase values empty to run in LOCAL MODE: data in .tools/data on this computer, no login.

# ─── Supabase (login + database) → Project Settings → API ───────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret. Server-only (media storage, invites/admin page, scripts/import-local.mjs). Never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Media go to the private "media" bucket (supabase/migrations/20261015000000_media_bucket.sql)
# SUPABASE_MEDIA_BUCKET=media

# ─── Optional: Cloudflare R2 for media instead of Supabase Storage ───────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=creator-hub-media

# Optional limits for invited users (admins have no total cap).
# Defaults: 200 MB per user + 50 MB per file (Supabase Free); 2048 / 500 with R2.
# STORAGE_LIMIT_MB=200
# MAX_UPLOAD_MB=50

# Fallback timezone; each browser normally reports its own
APP_TIMEZONE=America/Los_Angeles
