# Copy to .env.local and fill in. Leave the Supabase values empty to run in DEMO MODE
# (in-memory sample data, no login) — handy for trying the UI.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only these emails can log in (comma-separated)
ALLOWED_EMAILS=you@example.com

# "Today" and month boundaries are computed in this timezone
APP_TIMEZONE=America/Los_Angeles
